# Copy to `.env` next to docker-compose.yml and adjust.

# Timezone for the scheduled daily library sync (IANA name, e.g. America/New_York).
TZ=UTC

# Optional: pin the session cookie secret so logins survive redeploys.
# Generate with: openssl rand -hex 32
# SPUDCAST_COOKIE_SECRET=replace-with-openssl-rand-hex-32
